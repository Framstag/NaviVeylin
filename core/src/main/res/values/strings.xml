<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Turn-by-turn instruction text (spec: turn-instruction-localization).
         The native JNI bridge emits hardcoded English; the frontend rebuilds
         display text from these resources. English is the default locale. -->
    <string name="nav_start">Start</string>
    <string name="nav_arrive">Arrive</string>
    <string name="nav_roundabout">Roundabout</string>
    <string name="nav_exit_roundabout">Exit %1$d</string>
    <string name="nav_enter_motorway">Enter motorway</string>
    <string name="nav_leave_motorway">Leave motorway</string>

    <string name="nav_turn_sharp_left">Turn sharp left</string>
    <string name="nav_turn_left">Turn left</string>
    <string name="nav_turn_slightly_left">Turn slightly left</string>
    <string name="nav_straight_on">Straight on</string>
    <string name="nav_turn_slightly_right">Turn slightly right</string>
    <string name="nav_turn_right">Turn right</string>
    <string name="nav_turn_sharp_right">Turn sharp right</string>

    <string name="nav_keep_sharp_left">Keep sharp left</string>
    <string name="nav_keep_left">Keep left</string>
    <string name="nav_keep_slightly_left">Keep slightly left</string>
    <string name="nav_keep_straight">Keep straight</string>
    <string name="nav_keep_slightly_right">Keep slightly right</string>
    <string name="nav_keep_right">Keep right</string>
    <string name="nav_keep_sharp_right">Keep sharp right</string>

    <string name="nav_turn_into">%1$s into %2$s</string>
    <string name="nav_keep_onto">%1$s onto %2$s</string>
    <string name="nav_exit_onto">Take exit %1$d onto %2$s</string>
    <string name="nav_enter_onto">Enter %1$s</string>

    <!-- Car-screen hint fallback while no maneuver is known yet (rerouting, before the first instruction). -->
    <string name="nav_hint_neutral">Navigation active</string>
    <!-- Car-screen hint secondary text: distance to the maneuver plus arrival time. -->
    <string name="nav_hint_distance_eta">%1$s · %2$s</string>

    <!-- Map style load failure (spec: map-styles). Same wording on phone and car;
         the first form is used when no stylesheet ever loaded (empty map area),
         the second when the previously active style stays in effect. -->
    <string name="map_style_load_failed">Map style \"%1$s\" could not be loaded</string>
    <string name="map_style_load_failed_kept">Map style \"%1$s\" could not be loaded — still using \"%2$s\"</string>

    <!-- Navigation gate (spec: `location-permissions` — Starting navigation requires
         precise location). One wording for both surfaces: the phone offers the
         upgrade action, the car shows the message without launching settings. -->
    <string name="location_precise_required_navigation">Precise location is required for navigation. Approximate location is enough to browse the map, but a route needs the precise grant — otherwise the start point can be a kilometre off.</string>
    <string name="location_grant_precise_action">Grant precise location</string>

    <!-- Diagnostics disclosure (spec: auto-diagnostics — Export and viewers disclose
         the log contents). One wording for the phone dialog, the shared text and the
         car diagnostics screen. Must stay accurate to the implementation: no
         coordinates in the log, entries kept at most 7 days. -->
    <string name="diagnostics_disclosure">This log stays on this device. It records app and session events plus map database and object names — never coordinates. Entries older than 7 days are deleted.</string>

    <!-- In-app privacy statement (spec: about-dialog — About dialog states what the app
         does with location and diagnostics). Must stay accurate to the implementation:
         on-device only, no transmission, no coordinates in the log, 7-day retention. The
         map-data attribution stays where the dialog already shows it. -->
    <string name="about_privacy_statement">Location is used on this device for navigation and is never transmitted. The diagnostics log also stays on this device, contains no coordinates and is deleted after 7 days. Map data attribution is listed with the licenses below.</string>
    <!-- Row title for the same statement on the car about screen. -->
    <string name="about_privacy_title">Privacy</string>
</resources>
