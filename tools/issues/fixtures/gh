#!/usr/bin/env bash
# Stub `gh` for the issue tooling's offline self-test.
#
# It answers exactly the invocations `tools/issues/*.sh` make, from fixture files, so the whole toolchain
# runs with no token and no network (guidelines/Build.md §1; design D9). Anything else — and every write
# unless recording is switched on — exits non-zero with a visible message, so a call the fixtures do not
# describe is seen rather than silently passing.
#
# Reads (always answered):
#   gh api user --jq .login                       -> $GH_STUB_DIR/login.txt
#   gh repo view --json nameWithOwner [--jq …]    -> $GH_STUB_DIR/repo.txt
#   gh label list --json …                        -> $GH_STUB_DIR/labels.json
#   gh issue list [--state …] --json …            -> $GH_STUB_DIR/issues.json
#   gh issue view <n> --json …                    -> issue <n> of $GH_STUB_DIR/issues.json, carrying only the
#                                                    fields named after --json (as the real CLI does, so a
#                                                    reader that forgets a field is red here)
#   gh pr list [--state …] --json …               -> $GH_STUB_DIR/prs.json (the sensor tooling's open
#                                                    pull requests; a scenario may carry its own)
#   gh run list --workflow … --commit … --status … --json …
#                                                -> $GH_STUB_DIR/runs.json, filtered by the flags the
#                                                    caller passed (workflow file/name, headSha, status)
#   gh api repos/<owner>/<name>/actions/runs/<id>/artifacts [--paginate] [--jq …]
#                                                -> $GH_STUB_DIR/artifacts.json (the run's artifact names)
#   gh run download <id> --name … --dir …         -> copies $GH_STUB_DIR/artifact/<id>/ into --dir, so a
#                                                    scenario decides what an artifact contains
#
# Writes (refused unless GH_STUB_RECORD is set):
#   gh issue create|edit|close|comment …, gh label create|edit|delete …
#   with GH_STUB_RECORD=<file> the invocation is appended to <file> as one shell-quoted `gh …` line and a
#   plausible result is printed instead of the call being made. An `issue edit` carrying none of
#   --add-label, --remove-label or --body-file is refused, as the real CLI refuses it (#165).
#
# Env: GH_STUB_DIR (fixture directory, default: this file's directory), GH_STUB_RECORD (write log),
#      GH_STUB_FAIL (a substring of an invocation the stub must refuse, so a case can watch what a writer does
#      when `gh` itself fails mid-sequence — matched against the invocation as `gh <group> <sub> …`, so
#      `issue edit` is precise and `edit` is not).
set -uo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
stub="${GH_STUB_DIR:-$here}"

# A read the tracker *answers* with a failure, which is not the transport's (the block above): the retry seam
# passes it straight through (issue #231), so the caller has to decide what one unreadable candidate means. A case
# exports GH_STUB_READ_FAIL (a substring of an invocation) and the stub refuses those calls the way the GraphQL API
# does when the item it is asked for cannot be resolved.
if [ -n "${GH_STUB_READ_FAIL:-}" ] && printf 'gh %s\n' "$*" | grep -qF -- "$GH_STUB_READ_FAIL"; then
  printf 'GraphQL: Could not resolve to an issue or pull request with the number of %s. (repository.issue)\n' \
    "$(printf '%s\n' "$*" | awk '{print $3}')" >&2
  exit 1
fi

refuse() {
  printf 'stub gh: unsupported invocation: gh %s\n' "$*" >&2
  printf 'stub gh: fixtures are in %s — add the invocation there or change the tool\n' "$stub" >&2
  exit 1
}

need_file() {
  local path
  path=$(fixture_path "$1")
  [ -f "$path" ] || { printf 'stub gh: missing fixture %s\n' "$path" >&2; exit 1; }
}

# A scenario directory may carry only the fixtures it changes; anything it does not carry falls back to the
# base fixture directory next to this script.
fixture_path() {
  if [ -f "$stub/$1" ]; then printf '%s\n' "$stub/$1"; else printf '%s\n' "$here/$1"; fi
}

# The transport's failure, which is not the tracker's answer (issue #231). A case exports
# GH_STUB_TRANSIENT_FAIL (a substring of an invocation), GH_STUB_TRANSIENT_TIMES (how many of the matching
# invocations fail) and GH_STUB_TRANSIENT_STATE (a file in the case's own scratch directory holding the
# count), and the stub fails those calls the way a socket does — so a case can watch the tooling retry
# instead of reading the outage as an answer. The counter lives in the caller's scratch file, never in the
# fixture tree.
if [ -n "${GH_STUB_TRANSIENT_FAIL:-}" ] &&
   printf 'gh %s\n' "$*" | grep -qF -- "$GH_STUB_TRANSIENT_FAIL"; then
  transient_state="${GH_STUB_TRANSIENT_STATE:-${TMPDIR:-/tmp}/gh-stub-transient.$$}"
  transient_seen=0
  [ -f "$transient_state" ] && transient_seen=$(cat "$transient_state" 2>/dev/null || printf '0')
  case "$transient_seen" in ''|*[!0-9]*) transient_seen=0 ;; esac
  if [ "$transient_seen" -lt "${GH_STUB_TRANSIENT_TIMES:-1}" ]; then
    printf '%s\n' "$((transient_seen + 1))" > "$transient_state" 2>/dev/null || true
    printf 'Post "https://api.github.com/graphql": dial tcp 20.250.119.72:443: i/o timeout\n' >&2
    exit 1
  fi
fi

# The real CLI's vocabulary for a closure reason, and it is not the API's: `gh issue close --reason` takes
# `completed`, `not planned` (a space) or `duplicate`, while the API record spells the second `not_planned`.
# A stub that recorded any value let an argument the real tool refuses pass the self-test (#195).
check_close_reason() {
  local prev="" arg
  for arg in "$@"; do
    if [ "$prev" = "--reason" ]; then
      case "$arg" in
        completed|"not planned"|duplicate) ;;
        *)
          printf 'stub gh: `gh issue close --reason %s` — the CLI accepts completed, "not planned" or duplicate\n' "$arg" >&2
          exit 1
          ;;
      esac
    fi
    prev="$arg"
  done
}

# An `edit` with no field to edit is the shape the real CLI refuses (`field to edit flag required when not
# running interactively`), and it is the shape #165 filed with every suite green: the stub recorded any
# `issue edit` it was handed, so the one `gh` the suite ever runs could not show that the call was malformed.
# `tools/issues/update.sh` refuses to make that call itself (`edit_needed`, update.sh:192-196); the stub refuses
# it too, so a path added later that assembles an empty edit is red here rather than on a person's desk.
check_edit_field() {
  local arg
  for arg in "$@"; do
    case "$arg" in
      --add-label|--remove-label|--body-file) return 0 ;;
    esac
  done
  printf 'stub gh: `gh issue edit` with no field to edit — the CLI refuses it (`field to edit flag required when not running interactively`); pass --add-label, --remove-label or --body-file\n' >&2
  exit 1
}

record_write() {
  [ -n "${GH_STUB_RECORD:-}" ] || {
    printf 'stub gh: refusing the write `gh %s` — set GH_STUB_RECORD=<file> to record it\n' "$*" >&2
    exit 1
  }
  if [ -n "${GH_STUB_FAIL:-}" ] && printf 'gh %s\n' "$*" | grep -qF -- "$GH_STUB_FAIL"; then
    printf 'stub gh: the write `gh %s` failed (GH_STUB_FAIL=%s)\n' "$*" "$GH_STUB_FAIL" >&2
    exit 1
  fi
  # A `--body-file` is read by the real `gh` at call time, so the stub keeps the content it saw beside the
  # log: a case can then read what a writer put in a body after the writer's temporary file is gone. The
  # log's own shape is unchanged, so the log's readers are unaffected.
  local body_file="" arg="" seq=0
  for arg in "$@"; do
    [ "$arg" = "--body-file" ] && body_file="__next__" && continue
    if [ "$body_file" = "__next__" ]; then body_file="$arg"; fi
  done
  [ -f "$GH_STUB_RECORD" ] && seq=$(wc -l < "$GH_STUB_RECORD")
  {
    printf 'gh'
    for a in "$@"; do printf ' %q' "$a"; done
    printf '\n'
  } >> "$GH_STUB_RECORD"
  if [ -n "$body_file" ] && [ -f "$body_file" ]; then
    mkdir -p "$GH_STUB_RECORD.bodies"
    cp "$body_file" "$GH_STUB_RECORD.bodies/$((seq + 1))"
  fi
}

[ $# -gt 0 ] || refuse "(no arguments)"

group="$1"; shift

case "$group" in
  api)
    if [ "${1:-}" != "user" ]; then
      path="${1:-}"; shift || true
      case "$path" in
        repos/*/actions/runs/*/artifacts) ;;
        *) refuse "api $path" ;;
      esac
      jq_filter=""
      while [ $# -gt 0 ]; do
        case "$1" in
          --paginate) shift ;;
          --jq) jq_filter="${2:-}"; shift 2 ;;
          *) refuse "api $path $*" ;;
        esac
      done
      need_file artifacts.json
      if [ -n "$jq_filter" ]; then
        jq -r "$jq_filter" "$(fixture_path artifacts.json)"
      else
        cat "$(fixture_path artifacts.json)"
      fi
      exit 0
    fi
    shift
    jq_filter=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --jq) jq_filter="${2:-}"; shift 2 ;;
        *) refuse "api user $*" ;;
      esac
    done
    need_file login.txt
    login_path=$(fixture_path login.txt)
    if [ -n "$jq_filter" ]; then
      jq -nr --rawfile v "$login_path" '{"login": ($v | sub("\n$"; ""))} | '"$jq_filter"
    else
      tr -d '\n' < "$login_path"; echo
    fi
    ;;

  repo)
    [ "${1:-}" = "view" ] || refuse "repo $*"
    shift
    jq_filter=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --json|--jq) if [ "$1" = "--jq" ]; then jq_filter="${2:-}"; fi; shift 2 ;;
        *) refuse "repo view $*" ;;
      esac
    done
    need_file repo.txt
    repo_path=$(fixture_path repo.txt)
    if [ -n "$jq_filter" ]; then
      jq -nr --rawfile v "$repo_path" '{"nameWithOwner": ($v | sub("\n$"; ""))} | '"$jq_filter"
    else
      jq -nc --rawfile v "$repo_path" '{nameWithOwner: ($v | sub("\n$"; ""))}'
    fi
    ;;

  label)
    case "${1:-}" in
      list)
        shift
        while [ $# -gt 0 ]; do
          case "$1" in
            --json|--limit) [ "$1" = "--json" ] || true; shift 2 ;;
            *) refuse "label list $*" ;;
          esac
        done
        need_file labels.json
        cat "$(fixture_path labels.json)"
        ;;
      create|edit|delete)
        action="$1"; shift
        record_write label "$action" "$@"
        printf 'stub gh: recorded `gh label %s %s`\n' "$action" "${1:-}"
        ;;
      *) refuse "label $*" ;;
    esac
    ;;

  issue)
    sub="${1:-}"; shift || true
    case "$sub" in
      list)
        while [ $# -gt 0 ]; do
          case "$1" in
            --state|--limit|--json) shift 2 ;;
            --paginate) shift ;;
            *) refuse "issue list $*" ;;
          esac
        done
        need_file issues.json
        cat "$(fixture_path issues.json)"
        ;;
      view)
        number="${1:-}"; shift || true
        case "$number" in ''|*[!0-9]*) refuse "issue view $number" ;; esac
        fields=""
        while [ $# -gt 0 ]; do
          case "$1" in --json) fields="${2:-}"; shift 2 ;; *) refuse "issue view $*" ;; esac
        done
        need_file issues.json
        # `--json a,b` selects fields on the real CLI, and it is the only thing that makes a caller's field list
        # observable: a reader that forgets one (issue #196: `comments`, so the recorded answer never reached the
        # worker) must be red here rather than silently served everything by the stub.
        jq --argjson n "$number" --arg fields "$fields" '
          [.[] | select(.number == $n)]
          | if length != 1 then error("no fixture issue #\($n)") else .[0] end
          | if $fields == "" then . else
              . as $issue
              | reduce ($fields | split(",")[]) as $k ({}; if ($issue | has($k)) then . + {($k): $issue[$k]} else . end)
            end' "$(fixture_path issues.json)"
        ;;
      create|edit|close|comment|delete|reopen)
        [ "$sub" = "close" ] && check_close_reason "$@"
        [ "$sub" = "edit" ] && check_edit_field "$@"
        record_write issue "$sub" "$@"
        case "$sub" in
          create) printf 'https://example.invalid/%s/issues/1\n' "$(cat "$(fixture_path repo.txt)" 2>/dev/null || echo repo)" ;;
          *) printf 'stub gh: recorded `gh issue %s`\n' "$sub" ;;
        esac
        ;;
      *) refuse "issue $sub" ;;
    esac
    ;;

  run)
    sub="${1:-}"; shift || true
    case "$sub" in
      list)
        workflow=""; commit=""; status=""
        while [ $# -gt 0 ]; do
          case "$1" in
            --repo|--limit|--json) shift 2 ;;
            --workflow) workflow="${2:-}"; shift 2 ;;
            --commit) commit="${2:-}"; shift 2 ;;
            --status) status="${2:-}"; shift 2 ;;
            *) refuse "run list $*" ;;
          esac
        done
        need_file runs.json
        jq --arg workflow "$workflow" --arg commit "$commit" --arg status "$status" '
          [.[] | select(($workflow == "") or (.workflowName == $workflow) or (.workflowFile == $workflow))
               | select(($commit == "") or (.headSha == $commit))
               | select(($status == "") or (.status == $status))]' "$(fixture_path runs.json)"
        ;;
      download)
        id="${1:-}"; shift || true
        case "$id" in ''|*[!0-9]*) refuse "run download $id" ;; esac
        dir=""
        while [ $# -gt 0 ]; do
          case "$1" in
            --repo|--name) shift 2 ;;
            --dir) dir="${2:-}"; shift 2 ;;
            *) refuse "run download $*" ;;
          esac
        done
        [ -n "$dir" ] || refuse "run download $id (no --dir)"
        src="$stub/artifact/$id"
        [ -d "$src" ] || { printf 'stub gh: no artifact fixture at %s\n' "$src" >&2; exit 1; }
        mkdir -p "$dir"
        cp -R "$src"/. "$dir"/
        ;;
      *) refuse "run $sub" ;;
    esac
    ;;

  pr)
    [ "${1:-}" = "list" ] || refuse "pr $*"
    shift
    while [ $# -gt 0 ]; do
      case "$1" in
        --state|--limit|--json) shift 2 ;;
        --paginate) shift ;;
        *) refuse "pr list $*" ;;
      esac
    done
    need_file prs.json
    cat "$(fixture_path prs.json)"
    ;;

  *) refuse "$group $*" ;;
esac
