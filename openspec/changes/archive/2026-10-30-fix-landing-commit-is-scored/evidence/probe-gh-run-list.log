# why the score reads the push run: one headSha carries more than one workflow — a schedule run shares the landing commit, so the newest run for a sha is not always the pipeline the landing caused
$ gh run list --limit 40 --json headSha,event,workflowName --jq ...
[[{"event":"schedule","sha":"357a4670a0d0494e1b6b5b77679bc98e95432faa","workflow":"Sensors"},{"event":"schedule","sha":"357a4670a0d0494e1b6b5b77679bc98e95432faa","workflow":"Sensors"},{"event":"push","sha":"357a4670a0d0494e1b6b5b77679bc98e95432faa","workflow":"Build Debug APK"}],[{"event":"schedule","sha":"42d3e0004206ebfee39e11942db0bef375e1909e","workflow":"Sensors"},{"event":"push","sha":"42d3e0004206ebfee39e11942db0bef375e1909e","workflow":"Build Debug APK"}],[{"event":"schedule","sha":"53021e88394765372e6bfefa044ea2c5e5df247a","workflow":"Sensors"},{"event":"push","sha":"53021e88394765372e6bfefa044ea2c5e5df247a","workflow":"Build Debug APK"}]]
