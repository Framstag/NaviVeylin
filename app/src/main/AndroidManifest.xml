<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Android Auto (projection) -->
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />
    <uses-permission android:name="androidx.car.app.MAP_TEMPLATES" />
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />

    <!--
      The androidx.car.app:app-automotive AAR merges an
      android.hardware.type.automotive uses-feature (required=false) into every
      build. Google Play rejects that in combination with the
      com.google.android.gms.car.application metadata, so strip it here; the
      automotive flavor overlay (src/automotive/AndroidManifest.xml) re-declares
      it with required=true for the dedicated AAOS build.
    -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        tools:node="remove" />

    <!-- AAOS template host (renders CarAppService UI); required=false: the
         app also runs as a plain phone app where no host exists. -->
    <uses-feature
        android:name="android.software.car.templates_host"
        android:required="false" />

    <queries>
        <intent>
            <action android:name="androidx.car.app.CarAppService" />
        </intent>
        <package android:name="com.google.android.projection.gearhead" />
        <package android:name="com.google.android.apps.automotive.templates.host" />
        <provider
            android:name="androidx.car.app.connection.provider"
            android:authorities="androidx.car.app.connection" />
    </queries>

    <application
        android:name=".NaviVeylinApp"
        android:allowBackup="true"
        android:appCategory="maps"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NaviVeylin">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.NaviVeylin">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phone → car deep links (Android Auto): geo:, Google Maps URLs, text share -->
        <activity
            android:name=".DeepLinkActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
                <data android:scheme="geo" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
                <data android:scheme="https" android:host="maps.google.com" />
                <data android:scheme="https" android:host="www.google.com" />
                <data android:scheme="https" android:host="maps.app.goo.gl" />
                <data android:scheme="http" android:host="maps.google.com" />
                <data android:scheme="http" android:host="www.google.com" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.MapDownloadService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- Android Auto (projection) -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- AndroidX car app requires this so the host can negotiate the API level -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <!-- CarAppService -->
        <service
            android:name=".NaviVeylinCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
        </service>

        <!--
          Android Automotive OS entry point. On cars the phone MainActivity
          trampolines here; CarAppActivity binds the AAOS template host and
          renders the CarAppService UI. No launcher intent-filter — the single
          sideloaded APK keeps MainActivity as the launcher for phones, so the
          trampoline redirects on automotive hardware.
        -->
        <activity
            android:name="androidx.car.app.activity.CarAppActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>

    </application>

</manifest>
