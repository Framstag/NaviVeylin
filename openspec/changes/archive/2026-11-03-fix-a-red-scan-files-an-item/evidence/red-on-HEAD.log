# bash tools/sensor-selftest.sh --case workflow#theScanRecordIsFetchedBeforeItsRowRuns
# 2026-11-03T19:44:22Z
  the fetch does not ask the scan workflow: '--workflow sonar.yml' not found in:         id: record
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          if bash tools/fetch-build-inputs.sh --repo "$GITHUB_REPOSITORY" --commit "$GITHUB_SHA" --dest . \
               --conclusion-file "$RUNNER_TEMP/build-conclusion"; then
            echo "ready=true" >> "$GITHUB_OUTPUT"
            echo "conclusion=$(cat "$RUNNER_TEMP/build-conclusion")" >> "$GITHUB_OUTPUT"
          else
            status=$?
            if [ "$status" -eq 3 ]; then
              echo "ready=false" >> "$GITHUB_OUTPUT"
            else
              exit "$status"
            fi
          fi
          # The previous Sensors run's start time: the lower bound this tick's interval reaches back to.
          # A tick GitHub skipped leaves its minutes in this interval, so the row whose cadence fell into
          # the gap is selected by the next tick that runs, whatever the gap (issue #256). With no previous
          # run — the first tick — the interval is the schedule's own cadence.
          prev=$(gh run list --workflow sensors.yml --branch main --status completed --limit 1 \
            --json createdAt --jq '.[0].createdAt // empty' 2>/dev/null || true)
          [ -n "$prev" ] || prev=$(date -u -d '30 minutes ago' +%Y-%m-%dT%H:%M:%SZ)
          echo "since=$prev" >> "$GITHUB_OUTPUT"

      # The labels the checks file under are declared by the registry (`sensor/<id>`) and by the profile,
      # so they are created from that declaration before anything files: a filing under a label the tracker
      # does not carry would fail. Re-running is a no-op. Gated on the record like the rows: a run with
      # nothing to measure writes nothing at all (spec `backlog-sensors`, "no record yet … nothing is written").
FAIL workflow#theScanRecordIsFetchedBeforeItsRowRuns
exit=1

