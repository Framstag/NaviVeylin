# Machine-specific local properties
local.properties
mise.local.toml

# Release signing secrets (never commit)
app/keystore.properties
app/release.keystore
app/debug.keystore

# Release version state (managed by the release task)
app/release-version.properties

# Agent/tooling state. Everything under .pi/ is machine-local — session logs, device
# captures, instruction dumps, extension config — except the hand-written skills,
# which are versioned with the project. guidelines/Build.md §1 "Skills" owns the rule.
#
# `.pi/` must not lead this block: a negation cannot climb out of an excluded
# directory, so `.pi/` followed by `!.pi/skills/` re-includes nothing (measured in a
# scratch repository 2026-10-08 — the tracked set stayed empty). `.pi/*` excludes the
# children one by one, which lets `.pi/skills/` be re-admitted.
.pi/*
!.pi/skills/
# A stray file directly in .pi/skills/ is not a skill.
.pi/skills/*
# Every skill directory is admitted …
!.pi/skills/*/
# … except the ones the installed OpenSpec CLI generates and rewrites (`generatedBy:`
# in the frontmatter); committing one makes `openspec update` report the install as
# drifted. The two hand-written skills that share that prefix follow, and a new one
# needs its own line here.
.pi/skills/openspec-*/
!.pi/skills/openspec-open-changes/
!.pi/skills/openspec-proof-gap-audit/
.pi-subagents/

# Gradle build outputs
.gradle/
.kotlin/
/build/
*/build/

# CMake external build dirs
.cxx/
app/.cxx/

# IDE
.idea/
*.iml
*.iws
*.ipr

# OS
.DS_Store
Thumbs.db

# Native build
*.o
*.so
*.a

# Test-only JNI stubs (host-compiled, OSMScoutClient static loadLibrary) —
# committed so CI runners have them; keep them out of the APK by staying in
# src/test/jniLibs
!app/src/test/jniLibs/*.so
!auto/src/test/jniLibs/*.so

# vcpkg
vcpkg/

# Runner-local NuGet creds for the vcpkg binary cache (defensive; the
# workflow writes them to the user-level NuGet.Config, outside the repo)
NuGet.config

# OpenSpec: open changes are local WIP — only archived changes are versioned
openspec/changes/*/
!openspec/changes/archive/

# Misc runtime log accidentally committed
ki_processing_failures.log
